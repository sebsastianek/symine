{#- Strata: the project switcher. The name of the current project is already the title of the rail, so the trigger
    invites to switch instead of repeating it. On small screens the rail is folded away: the name is shown there. -#}
{% if current_user().isLogged() and path_exists('projects_autocomplete') %}
<div id="project-jump" class="drdn"><span class="drdn-trigger"><span class="st-jump-label">{{ l('label_jump_to_a_project') }}</span>{% if project %}<span class="st-jump-current">{{ project.name }}</span>{% endif %}</span>
<div class="drdn-content"><div class="quick-search">{{ sprite_icon('search') }}<input type="text" name="q" id="projects-quick-search" value="" class="autocomplete" data-automcomplete-url="{{ path('projects_autocomplete', {jump: main_menu_selected ?? ''}) }}" autocomplete="off" /></div>
<div class="drdn-items projects selection">{{ project_jump_box_items(project ?? null, main_menu_selected ?? null) }}</div>
<div class="drdn-items all-projects selection"><a class="selected" href="{{ path('projects_index', {jump: main_menu_selected ?? ''}) }}">{{ l('label_project_all') }}</a></div></div></div>
{% endif %}
