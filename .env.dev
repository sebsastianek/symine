# Redmine 7 "scm_<name>_path_regexp": an SCM can only be used when its path regexp is set.
# Development default: any path. Configure SYMINE_SCM_<NAME>_PATH_REGEXP / _COMMAND / _PATH_INFO in production.
SYMINE_SCM_SUBVERSION_PATH_REGEXP=.+
SYMINE_SCM_MERCURIAL_PATH_REGEXP=.+
SYMINE_SCM_CVS_PATH_REGEXP=.+
SYMINE_SCM_BAZAAR_PATH_REGEXP=.+
SYMINE_SCM_GIT_PATH_REGEXP=.+
SYMINE_SCM_FILESYSTEM_PATH_REGEXP=.+
###< symine/scm ###
