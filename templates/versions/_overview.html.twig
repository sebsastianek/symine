{% import 'versions/_macros.html.twig' as vm %}
<div class="version-overview">
{% if version_completed(version) %}
  <p>{{ format_date(version.effectiveDate) }}</p>
{% elseif version.effectiveDate %}
  <p><strong>{{ due_date_distance(version.effectiveDate) }}</strong> ({{ format_date(version.effectiveDate) }})</p>
{% endif %}

<p>{{ version.description }}</p>
{% set cvs = version_custom_values(version) %}
{% if cvs is not empty %}
<ul>
  {% for cv in cvs %}
    <li><span class="label">{{ cv.field.name }}:</span> {{ issue_cf_value_html(cv.field, cv.value, version.project, version) }}</li>
  {% endfor %}
</ul>
{% endif %}

{% set st = version_stats(version, true) %}
{% if st.count > 0 %}
    {{ vm.progress_bar([st.closed_percent, st.completed_percent], (st.completed_percent|round(0, 'floor')) ~ '%', [l('label_closed_issues_plural') ~ ': ' ~ (st.closed_percent|round(0, 'floor')) ~ '%', l('field_done_ratio') ~ ': ' ~ (st.completed_percent|round(0, 'floor')) ~ '%']) }}
    <p class="progress-info">
      {{ vm.link_if(true, l('label_x_issues', {count: st.count}), version_filtered_issues_path(version, {status_id: '*'})) }}
      &nbsp;
      ({{ vm.link_if(st.closed > 0, l('label_x_closed_issues_abbr', {count: st.closed}), version_filtered_issues_path(version, {status_id: 'c'})) }}
      &#8212;
      {{ vm.link_if(st.open > 0, l('label_x_open_issues_abbr', {count: st.open}), version_filtered_issues_path(version, {status_id: 'o'})) }})
    </p>
{% else %}
    <p class="progress-info">{{ l('label_roadmap_no_issues') }}</p>
{% endif %}
</div>
