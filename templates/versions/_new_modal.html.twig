<h3 class="title">{{ l('label_version_new') }}</h3>

<form class="new_version" id="new_version" enctype="multipart/form-data" action="{{ path('version_create', {project_id: project.identifier}) }}" accept-charset="UTF-8" data-remote="true" method="post">{{ csrf_field() }}
{% include 'versions/_form.html.twig' %}
  <p class="buttons">
    <input type="submit" value="{{ l('button_create') }}" data-disable-with="{{ l('button_create') }}" />
    <a href="#" onclick="hideModal(this); return false;">{{ l('button_cancel') }}</a>
  </p>
</form>
