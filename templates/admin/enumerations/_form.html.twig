{% import 'admin/custom_fields/_macros.html.twig' as f %}
{{ f.errors(errors) }}

<div class="box tabular">
  <p><label for="enumeration_name">{{ l('field_name') }}</label><input type="text" value="{{ enumeration.name }}" name="enumeration[name]" id="enumeration_name" /></p>
  <p><label for="enumeration_active">{{ l('field_active') }}</label><input name="enumeration[active]" type="hidden" value="0" autocomplete="off" /><input type="checkbox" value="1"{% if enumeration.active %} checked="checked"{% endif %} name="enumeration[active]" id="enumeration_active" /></p>
  <p><label for="enumeration_is_default">{{ l('field_is_default') }}</label><input name="enumeration[is_default]" type="hidden" value="0" autocomplete="off" /><input type="checkbox" value="1"{% if enumeration.isDefault %} checked="checked"{% endif %} name="enumeration[is_default]" id="enumeration_is_default" /></p>

  {% for cfv in custom_field_values %}
    <p>{% include 'admin/enumerations/_custom_field_tag.html.twig' with {prefix: 'enumeration', cf: cfv.field, value: cfv.value, options: cfv.options} %}</p>
  {% endfor %}
</div>
