{% extends 'admin/layout.html.twig' %}
{% block content %}
<h2>{{ l('label_settings') }}</h2>

{% if setting_errors|length > 0 %}
<div id="errorExplanation">{{ sprite_icon('warning') }}<ul>{% for name, message in setting_errors %}<li><b>{{ l('setting_' ~ name) }}</b> {{ message }}</li>{% endfor %}</ul></div>
{% endif %}

{% include 'admin/_tabs.html.twig' with {tabs: tabs} %}
{% endblock %}
