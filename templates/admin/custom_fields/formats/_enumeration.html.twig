{% import 'admin/custom_fields/_macros.html.twig' as f %}
{% if custom_field.id %}
<p>
  <label>{{ l('field_possible_values') }}</label>
  <a class="icon icon-edit" href="{{ path('custom_field_enumerations', {custom_field_id: custom_field.id}) }}">{{ sprite_icon('edit', l('button_edit')) }}</a>
</p>
{% if active_enumerations|length > 0 %}
  <p>{{ f.select('default_value', active_enumerations|map(e => [e.name, e.id ~ '']), custom_field.defaultValue, l('field_default_value'), true) }}</p>
{% endif %}
{% endif %}

<p>{{ f.text_field('url_pattern', custom_field.getFormatOption('url_pattern'), l('label_link_values_to'), 50) }}</p>
<p>{{ f.edit_tag_style(custom_field) }}</p>
