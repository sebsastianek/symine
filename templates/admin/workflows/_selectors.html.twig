{#- role/tracker selection form shared by edit & permissions (options_for_workflow_select) -#}
<p>{{ l('text_workflow_edit') }}:</p>

<form action="{{ form_action }}" accept-charset="UTF-8" method="get" id="workflow_selection_form">
<p>
  {% for sel in [{label: 'label_role', name: 'role_id', data: role_select}, {label: 'label_tracker', name: 'tracker_id', data: tracker_select}] %}
  <label>{{ l(sel.label) }}:
  <select name="{{ sel.name }}[]" id="{{ sel.name }}" class="expandable"{% if sel.data.multiple %} multiple="multiple"{% endif %}><option{% if sel.data.all_selected %} selected="selected"{% endif %} value="all"{% if sel.data.multiple %} style="display:none;"{% endif %}>{{ l('label_all') }}</option>{% for o in sel.data.options %}<option{% if o.selected %} selected="selected"{% endif %} value="{{ o.id }}">{{ o.name }}</option>
{% endfor %}</select>
  <span class="toggle-multiselect icon-only">{{ sprite_icon('') }}</span>
  </label>

  {% endfor %}
  <input type="submit" value="{{ l('button_edit') }}" data-disable-with="{{ l('button_edit') }}" />

  <input type="hidden" name="used_statuses_only" value="0" autocomplete="off" />
  <label><input type="checkbox" name="used_statuses_only" id="used_statuses_only" value="1"{% if used_statuses_only %} checked="checked"{% endif %} /> {{ l('label_display_used_statuses_only') }}</label>
</p>
</form>
{#- Symine: the page always shows what the selectors say. Choosing a role or tracker reloads it at once (after asking,
    when the table below has unsaved changes); the "Edit" button stays for browsers without JavaScript. -#}
<script>
//<![CDATA[
$(function() {
  var form = $('#workflow_selection_form'), timer = null, dirty = false;
  $('#workflow_form').on('change', 'input, select', function() { dirty = true; });
  form.find('select, input[type=checkbox]').each(function() { $(this).data('shown', $(this).is(':checkbox') ? this.checked : $(this).val()); });
  form.on('change', 'select, input[type=checkbox]', function() {
    var field = $(this);
    window.clearTimeout(timer);
    if (dirty && !window.confirm({{ l('text_warn_on_leaving_unsaved')|json_encode|raw }})) {
      // stay: the selector goes back to what the table shows
      if (field.is(':checkbox')) { this.checked = field.data('shown'); } else { field.val(field.data('shown')); }
      return;
    }
    dirty = false;
    // several roles or trackers can be picked one after the other before the page reloads
    timer = window.setTimeout(function() { form.trigger('submit'); }, field.is('select[multiple]') ? 800 : 0);
  });
});
//]]>
</script>
