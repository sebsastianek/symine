{% if webhooks|length > 0 %}
<div class="autoscroll">
<table class="list webhooks">
  <thead><tr>
    {% if show_author %}<th>{{ l('field_user') }}</th>{% endif %}
    <th>{{ l('field_active') }}</th>
    <th>{{ l('field_url') }}</th>
    <th>{{ l('label_webhook_events') }}</th>
    <th>{{ l('label_project_plural') }}</th>
    <th></th>
  </tr></thead>
  <tbody>
  {% for webhook in webhooks %}
    {% set link_params = back_url ? {back_url: back_url} : {} %}
    <tr id="webhook_{{ webhook.id }}" class="{{ cycle(['odd', 'even'], loop.index0) }}">
      {% if show_author %}<td>{{ link_to_user(webhook.user) }}</td>{% endif %}
      <td>{{ webhook.active ? l('general_text_Yes') : l('general_text_No') }}</td>
      <td title="{{ webhook.url }}">{{ webhook.url|truncate(40) }}</td>
      <td>{% for e in webhook.getEvents() %}<code>{{ e }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</td>
      <td>{% for link in webhook.projectLinks %}{{ link_to_project(link.project) }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
      <td class="buttons">
        <a href="{{ path('webhook_edit', {id: webhook.id}|merge(link_params)) }}" class="icon icon-edit">{{ sprite_icon('edit', l('button_edit')) }}</a>
        <a href="{{ path('webhook_destroy', {id: webhook.id}|merge(link_params)) }}" data-confirm="{{ l('text_are_you_sure') }}" data-method="delete" rel="nofollow" class="icon icon-del">{{ sprite_icon('del', l('button_delete')) }}</a>
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% else %}
  <p class="nodata">{{ l('label_no_data') }}</p>
{% endif %}
