{% extends 'admin/layout.html.twig' %}
{% block content %}
<h2>{{ l('label_confirmation') }}</h2>

<form action="{{ path('user_destroy', {id: edited_user.id}) }}" accept-charset="UTF-8" method="post">
{{ csrf_field() }}
<input type="hidden" name="_method" value="delete" autocomplete="off" />
<div class="warning">
  <p><strong>{{ edited_user.getName() }} ({{ edited_user.login }})</strong></p>

  <p>{{ l('text_user_destroy_confirmation', {login: edited_user.login}) }}</p>

  <p>
    <label for="confirm">{{ l('field_login') }}</label>
    <input type="text" name="confirm" id="confirm" />
  </p>
</div>

<input type="submit" name="commit" value="{{ l('button_delete') }}" />
</form>
{% if not edited_user.isLocked() %}
<form class="button_to" method="post" action="{{ path('users_bulk_lock', {'ids[]': edited_user.id}) }}">{{ csrf_field() }}<button class="btn" type="submit" name="lock">{{ l('button_lock') }}</button></form>
{% endif %}
<a href="{{ path('users_index') }}">{{ l('button_cancel') }}</a>
{% endblock %}
