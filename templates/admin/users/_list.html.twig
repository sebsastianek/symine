{#- users/_list.html.erb -#}
<form data-cm-url="{{ path('users_context_menu') }}" action="{{ path('users_index') }}" accept-charset="UTF-8" method="post">{{ csrf_field() }}<input type="hidden" name="back_url" value="{{ app.request.requestUri }}" autocomplete="off" />
<div class="autoscroll">
<table class="list odd-even users">
<thead>
  <tr>
    <th class="checkbox hide-when-print">
      <input type="checkbox" name="check_all" id="check_all" value="" class="toggle-selection" title="{{ l('button_check_all') }} / {{ l('button_uncheck_all') }}" />
    </th>
    {% for column in query.inlineColumns() %}
      {{ query_column_header(query, column) }}
    {% endfor %}
    <th></th>
  </tr>
</thead>
<tbody>
{% set cyc = 0 %}
{% for row in user_query_rows(query, users) %}
  {% set u = row.user %}
  {% if row.group_name is not null %}
    {% set cyc = 0 %}
    <tr class="group open">
      <td colspan="{{ query.inlineColumns()|length + 2 }}">
        <span class="expander" onclick="toggleRowGroup(this);">{{ sprite_icon('angle-down') }}</span>
        <span class="name">{{ row.group_name|raw }}</span>
        {% if row.group_count is not null %}
        <span class="count">{{ row.group_count }}</span>
        {% endif %}
        <span class="totals">{{ row.group_totals|raw }}</span>
        <a href="#" onclick="toggleAllRowGroups(this); return false;" class="toggle-all">{{ l('button_collapse_all') }}/{{ l('button_expand_all') }}</a>
      </td>
    </tr>
  {% endif %}
  {% set cyc = cyc + 1 %}
  <tr id="user-{{ u.id }}" class="hascontextmenu {{ cyc is odd ? 'odd' : 'even' }} user {{ u.isActive() ? 'active' : (u.isLocked() ? 'locked' : (u.isRegistered() ? 'registered' : 'anon')) }}">
    <td class="checkbox hide-when-print"><input type="checkbox" name="ids[]" value="{{ u.id }}" /></td>
    {% for column in query.inlineColumns() %}
      {% if column.name == 'login' %}
        <td class="{{ column.cssClasses() }}"><a href="{{ path('user_edit', {id: u.id}) }}">{{ u.login }}</a></td>
      {% else %}
        <td class="{{ column.cssClasses() }}">{{ user_query_column_content(query, column, u) }}</td>
      {% endif %}
    {% endfor %}
    <td class="buttons">
      <a title="{{ l('button_actions') }}" class="icon-only icon-actions js-contextmenu " href="#">{{ sprite_icon('3-bullets', l('button_actions')) }}</a>
    </td>
  </tr>
  {% for column in query.blockColumns() %}
    {% set text = user_query_column_content(query, column, u) %}
    {% if text is not empty %}
  <tr class="{{ cyc is odd ? 'odd' : 'even' }}">
    <td colspan="{{ query.inlineColumns()|length + 1 }}" class="{{ column.cssClasses() }}">
    {% if query.blockColumns()|length > 1 %}<span>{{ column.caption }}</span>{% endif %}
    {{ text|raw }}
    </td>
  </tr>
    {% endif %}
  {% endfor %}
{% endfor %}
</tbody>
</table>
</div>
</form>
