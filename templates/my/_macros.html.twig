{#- Helpers shared by the My account / account / timelog templates (Redmine's error_messages_for, custom_field_tag_with_label) -#}
{% macro errors(errors) %}{% if errors is not empty %}<div id="errorExplanation">{{ sprite_icon('warning') }}<ul>
{% for e in errors %}<li>{{ e }}</li>
{% endfor %}</ul></div>{% endif %}{% endmacro %}


{#- Renders the input of a custom field with the widget shared by every form (CustomFieldsHelper#custom_field_tag).
    object_name: "user", "time_entry"; project: project of the customized object (user / version fields).
    options and name_override are kept for compatibility and ignored: the widget computes the possible values itself -#}
{% macro cf_tag(object_name, field, value, options = [], name_override = null, project = null) %}
{{- issue_cf_tag(object_name, field, value, project, false, false) -}}
{% endmacro %}

{% macro cf_label(object_name, field) %}<label for="{{ object_name }}_custom_field_values_{{ field.id }}"{% if field.description %} title="{{ field.description }}"{% endif %}><span>{{ field.name }}</span>{% if field.isRequired %}<span class="required"> *</span>{% endif %}</label>{% endmacro %}
