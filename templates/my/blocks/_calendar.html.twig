<h3>{{ l('label_calendar') }}</h3>

<form data-cm-url="{{ path_exists('issues_context_menu') ? path('issues_context_menu') : '' }}" action="{{ path('my_page') }}" accept-charset="UTF-8" method="post">{{ csrf_field() }}<input type="hidden" name="back_url" value="{{ path('my_page') }}" autocomplete="off" />
<ul class="cal">
  <li scope="col" title="{{ l('label_week') }}" class="calhead week-number"></li>
  {% for i in 0..6 %}
    <li scope="col" class="calhead">{{ i18n.dayName((b.first_wday + i) % 7) }}</li>
  {% endfor %}
    <li class='week-number'>
      <span class="label-week">{{ l('label_week') }}</span> {{ b.week_number }}
    </li>
    {% for day in b.days %}
    <li class="{{ day.css }} calbody">
      <p class="day-num">
        <span class="day-value">{{ day.date|date('j') }}</span>
        <span class="abbr-day">({{ l('date.abbr_day_names.' ~ (day.date|date('w'))) }})</span>
      </p>
      {% for i in day.events %}
        {% set starting = i.startDate and i.startDate|date('Y-m-d') == day.date|date('Y-m-d') %}
        {% set ending = i.dueDate and i.dueDate|date('Y-m-d') == day.date|date('Y-m-d') %}
        <div class="{{ issue_css_classes(i) }} tooltip hascontextmenu{% if starting %} starting{% endif %}{% if ending %} ending{% endif %}">
          {{ i.project.name }} -
          {% if starting and not ending %}{{ sprite_icon('bullet-go') }}{% endif %}
          {% if ending and not starting %}{{ sprite_icon('bullet-end') }}{% endif %}
          {% if starting and ending %}{{ sprite_icon('bullet-go-end') }}{% endif %}
          {{ link_to_issue(i, {truncate: 30}) }}
          <span class="tip"><strong>{{ i.tracker.name }} #{{ i.id }}</strong>: {{ i.subject }}<br /><strong>{{ l('field_project') }}</strong>: {{ i.project.name }}<br /><strong>{{ l('field_status') }}</strong>: {{ i.status.name }}<br /><strong>{{ l('field_start_date') }}</strong>: {{ format_date(i.startDate) }}<br /><strong>{{ l('field_due_date') }}</strong>: {{ format_date(i.dueDate) }}<br /><strong>{{ l('field_assigned_to') }}</strong>: {{ i.assignedTo ? i.assignedTo.getName() : '' }}<br /><strong>{{ l('field_priority') }}</strong>: {{ i.priority.name }}</span>
          <input type="checkbox" name="ids[]" value="{{ i.id }}" style="display:none;" />
        </div>
      {% endfor %}
    </li>
    {% endfor %}
</ul>
</form>
