<h3>{{ l('label_my_account') }}</h3>

<p>{{ l('field_login') }}: <strong><a class="user active" href="{{ path_exists('user_show') ? path('user_show', {id: user.id}) : '#' }}">{{ user.login }}</a></strong><br />
{{ l('field_created_on') }}: {{ format_time(user.createdOn) }}</p>

{% if deletable %}
  <p><a class="icon icon-del" href="{{ path('my_account_destroy') }}">{{ sprite_icon('del', l('button_delete_my_account')) }}</a></p>
{% endif %}

<h4>{{ l('label_feeds_access_key') }}</h4>

<p>
{% if atom_token %}
  {{ l('label_feeds_access_key_created_on', {value: distance_of_time(atom_token.createdOn)}) }}<br />
  {% if atom_token.updatedOn and atom_token.updatedOn > atom_token.createdOn %}
    {{ l('label_last_used_on', {value: distance_of_time(atom_token.updatedOn)}) }}
  {% else %}
    {{ l('label_never_used') }}
  {% endif %}
{% else %}
  {{ l('label_missing_feeds_access_key') }}
{% endif %}
(<a rel="nofollow" data-method="post" href="{{ path('my_atom_key') }}">{{ l('button_reset') }}</a>)
</p>

{% if settings.restApiEnabled() %}
<h4>{{ l('label_api_access_key') }}</h4>
<div data-controller="api-key-copy">
  <div class="api-key-actions">
    <a data-remote="true" href="{{ path('my_api_key') }}">{{ l('button_show') }}</a>
    <a class="copy-api-key-link icon icon-only"
       title="{{ l('button_copy') }}"
       aria-label="{{ l('button_copy') }}"
       href="#"
       role="button"
       tabindex="0"
       style="display: none;"
       data-action="click->api-key-copy#copy">
      {{ sprite_icon('copy') }}
    </a>
  </div>
  <pre id='api-access-key' class='autoscroll' data-api-key-copy-target="apiKey"></pre>
  <script>
//<![CDATA[
$('#api-access-key').hide();
//]]>
</script>
  <p>
  {% if api_token %}
    {{ l('label_api_access_key_created_on', {value: distance_of_time(api_token.createdOn)}) }}<br />
    {% if api_token.updatedOn and api_token.updatedOn > api_token.createdOn %}
      {{ l('label_last_used_on', {value: distance_of_time(api_token.updatedOn)}) }}
    {% else %}
      {{ l('label_never_used') }}
    {% endif %}
  {% else %}
    {{ l('label_missing_api_access_key') }}
  {% endif %}
  (<a rel="nofollow" data-method="post" href="{{ path('my_api_key_reset') }}">{{ l('button_reset') }}</a>)
  </p>
</div>
{% endif %}
