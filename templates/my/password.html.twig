{% extends 'base.html.twig' %}
{% import 'my/_macros.html.twig' as m %}
{% block content %}
{% if error %}<div class="flash error" id="flash_error">{{ sprite_icon('warning') }}{{ error }}</div>{% endif %}
<h2>{{ l('button_change_password') }}</h2>

{{ m.errors(errors) }}

<form class="tabular" action="{{ path('my_password') }}" accept-charset="UTF-8" method="post">{{ csrf_field() }}
<div class="box">
<p><label for="password">{{ l('field_current_password') }} <span class="required">*</span></label>
<input type="password" name="password" id="password" size="25" autocomplete="current-password" /></p>

<p><label for="new_password">{{ l('field_new_password') }} <span class="required">*</span></label>
<input type="password" name="new_password" id="new_password" size="25" autocomplete="new-password" />
  <em class="info">{{ l('text_caracters_minimum', {count: settings.int('password_min_length')}) }}</em>
  {% set classes = settings.array('password_required_char_classes') %}
  {% if classes is not empty %}
    <em class="info">{{ l('text_characters_must_contain', {character_classes: classes|map(c => l('label_password_char_class_' ~ c))|join(', ')}) }}</em>
  {% endif %}
</p>

<p><label for="new_password_confirmation">{{ l('field_password_confirmation') }} <span class="required">*</span></label>
<input type="password" name="new_password_confirmation" id="new_password_confirmation" size="25" autocomplete="new-password" /></p>
</div>
<input type="submit" name="commit" value="{{ l('button_apply') }}" />
</form>
{% endblock %}

{% block sidebar %}
{% if not must_change %}{% include 'my/_sidebar.html.twig' %}{% endif %}
{% endblock %}
