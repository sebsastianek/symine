{#- my/add_block.js.erb -#}
{% autoescape false %}
$("#block-{{ block|account_js }}").remove();
$("#list-top").prepend("{{ (b is null ? '' : include('my/_block.html.twig', {b: b}, with_context = false))|account_js }}");
$("#block-select").replaceWith("{{ include('my/_block_select.html.twig', {block_options: block_options}, with_context = false)|account_js }}");
{% endautoescape %}
