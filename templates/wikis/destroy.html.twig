{% extends 'base.html.twig' %}
{% block content %}
<h2>{{ l('label_confirmation') }}</h2>

<div class="warning">
  <p><strong>{{ project.name }}</strong><br />{{ l('text_wiki_destroy_confirmation') }}</p>
</div>

<form action="{{ path('wikis_destroy', {id: project.identifier}) }}" accept-charset="UTF-8" method="post">{{ csrf_field() }}
  <input type="hidden" name="confirm" id="confirm" value="1" autocomplete="off" />
  <input type="submit" value="{{ l('button_delete') }}" data-disable-with="{{ l('button_delete') }}" />
  <a href="javascript:history.back()">{{ l('button_cancel') }}</a>
</form>
{% endblock %}
