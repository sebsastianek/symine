{#- issues/index.html.erb -#}
{% extends 'base.html.twig' %}
{% import 'queries/_macros.html.twig' as qm %}

{% block header_tags %}
{{ qm.calendar_headers() }}
{{ qm.context_menu_tags() }}
<link rel="alternate" type="application/atom+xml" title="{{ l('label_issue_plural') }}" href="{{ app.request.schemeAndHttpHost ~ issue_query_url(project, (query.isNew() ? {} : {query_id: query.record.id})|merge(atom_key ? {key: atom_key} : {}), 'atom') }}" />
{% endblock %}

{% block content %}
<div class="contextual">
  {% if can_add_issues %}
    {% if project and path_exists('issue_new') %}
    <a class="icon icon-add new-issue" href="{{ path('issue_new', {project_id: project.identifier}) }}">{{ sprite_icon('add', l('label_issue_new')) }}</a>
    {% elseif not project and path_exists('issues_new') %}
    <a class="icon icon-add new-issue" href="{{ path('issues_new') }}">{{ sprite_icon('add', l('label_issue_new')) }}</a>
    {% endif %}
  {% endif %}
  {% set actions %}
    {% if project and path_exists('issues_report') %}
      <a class="icon icon-stats" href="{{ path('issues_report', {id: project.identifier}) }}">{{ sprite_icon('summary', l('field_summary')) }}</a>
    {% endif %}
    {% if can_import and path_exists('issues_import_new') %}
      <a class="icon icon-import" href="{{ path('issues_import_new', project ? {project_id: project.identifier} : {}) }}">{{ sprite_icon('import', l('button_import')) }}</a>
    {% endif %}
    {% if project and allowed_to('edit_project', project) and path_exists('project_settings') %}
    <a class="icon icon-settings" href="{{ path('project_settings', {id: project.identifier, tab: 'issues'}) }}">{{ sprite_icon('settings', l('label_settings')) }}</a>
    {% endif %}
  {% endset %}
  {% if actions|trim is not empty %}
  <span class="drdn"><span class="drdn-trigger"><span class="icon-only icon-actions" title="{{ l('button_actions') }}">{{ sprite_icon('3-bullets', l('button_actions')) }}</span></span><div class="drdn-content"><div class="drdn-items">
{{ actions }}
</div></div></span>{% endif -%}
</div>

<h2>{{ query.isNew() ? l('label_issue_plural') : query.name() }}</h2>
{% if not query.isNew() and query.record.description %}<p class="subtitle">{{ query.record.description }}</p>{% endif %}

<form id="query_form" action="{{ issue_query_url(project) }}" accept-charset="UTF-8" method="get">
  {% include 'queries/_query_form.html.twig' with {
      query: query,
      clear_url: issue_query_url(project, {set_filter: 1, sort: ''}),
      new_query_url: project ? path('project_query_new', {project_id: project.identifier}) : path('query_new'),
  } %}
</form>

{% include 'issues/_index_content.html.twig' %}
{{ call_hook('view_issues_index_bottom', {issues: issues ?? [], project: project, query: query}) }}
{% endblock %}

{% block sidebar %}
{% include 'issues/_sidebar.html.twig' %}
{% endblock %}
