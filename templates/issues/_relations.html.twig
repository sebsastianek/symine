<div class="contextual">
{% if allowed_to('manage_issue_relations', project) %}
  <a class="icon icon-link-add" onclick="$('#new-relation-form').toggle(); $('#relation_issue_to_id:visible').focus(); return false;" href="#">{{ sprite_icon('link-add', l('button_add')) }}</a>
{% endif %}
</div>

<p>
  <strong>{{ l('label_related_issues') }}</strong>
  {% if relations|length > 0 %}{{ issue_relations_stats(issue, relations) }}{% endif %}
</p>

{% if relations|length > 0 %}
<form data-cm-url="{{ path_exists('issues_context_menu') ? path('issues_context_menu') : '' }}" action="{{ path('issue_show', {id: issue.id}) }}" method="post">
  {{ csrf_field() }}
  <div class="relation-issues-wrapper">
    {{ issue_relations_table(issue, relations) }}
  </div>
</form>
{% endif %}

{% if allowed_to('manage_issue_relations', project) %}
<form class="new_relation" id="new-relation-form" style="display: none;" action="{{ path('issue_relations_create', {issue_id: issue.id}) }}" accept-charset="UTF-8" data-remote="true" method="post">
{{ csrf_field() }}
{% include 'issue_relations/_form.html.twig' %}
</form>
{% endif %}
