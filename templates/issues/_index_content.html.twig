{#- Result part of issues/index.html.erb (also rendered alone for XHR requests) -#}
{% if query.isValid() %}
{% if issues is empty %}
<p class="nodata">{{ l('label_no_data') }}</p>
{% else %}
{{ render_query_totals(query) }}
{% include 'issues/_list.html.twig' with {issues: issues, query: query} %}
{% include 'common/_pagination.html.twig' with {pager: pager} %}
{% endif %}

<p class="other-formats hide-when-print">{{ l('label_export_to') }}
  {% if export_allowed %}
  <span><a class="csv" rel="nofollow" onclick="showModal('csv-export-options', '350px'); return false;" href="{{ issue_query_url(project, app.request.query.all, 'csv') }}">CSV</a></span>
  <span><a class="pdf" rel="nofollow" href="{{ issue_query_url(project, app.request.query.all|filter((v, k) => k != 'page'), 'pdf') }}">PDF</a></span>
  {% endif %}
  <span><a class="atom" rel="nofollow" href="{{ issue_query_url(project, app.request.query.all|merge(atom_key ? {key: atom_key} : {}), 'atom') }}">Atom</a></span>
</p>

{% if export_allowed %}
<div id="csv-export-options" style="display:none;">
  <h3 class="title">{{ l('label_export_options', {export_format: 'CSV'}) }}</h3>
  <form id="csv-export-form" action="{{ issue_query_url(project, {}, 'csv') }}" accept-charset="UTF-8" method="get">
  {{ query_as_hidden_field_tags(query) }}
  <input type="hidden" name="query_name" id="query_name" value="{{ query.name() }}" autocomplete="off" />
  <p>
    <label><input type="radio" name="c[]" id="c__" value="" checked="checked" /> {{ l('description_selected_columns') }}</label><br />
    <label><input type="radio" name="c[]" id="c__all_inline" value="all_inline" /> {{ l('description_all_columns') }}</label>
  </p>
  {% if query.availableBlockColumns() is not empty %}
    <fieldset id="csv-export-block-columns">
      <legend>
        <a href="#" onclick="toggleCheckboxesBySelector(&#39;#csv-export-block-columns input[type=checkbox]&#39;); return false;" title="{{ l('button_check_all') }} / {{ l('button_uncheck_all') }}" class="icon icon-checked">{{ sprite_icon('checked', '') }}</a>
      </legend>
      {% for column in query.availableBlockColumns() %}
        <label><input type="checkbox" name="c[]" value="{{ column.name }}"{% if query.hasColumn(column.name) %} checked="checked"{% endif %} /> {{ column.caption }}</label>
      {% endfor %}
    </fieldset>
  {% endif %}
  {% set csv_encoding = l('general_csv_encoding') %}
  {% if csv_encoding|upper != 'UTF-8' %}
  <p><label>{{ l('label_encoding') }} <select name="encoding" id="encoding"><option selected="selected" value="UTF-8">UTF-8</option>
<option value="{{ csv_encoding }}">{{ csv_encoding }}</option></select></label></p>
  {% endif %}
  {% set csv_sep = l('general_csv_separator') %}
  <p><label>{{ l('label_fields_separator') }} <select name="field_separator" id="field_separator"><option{% if csv_sep == ',' %} selected="selected"{% endif %} value=",">{{ l('label_comma_char') }}</option>
<option{% if csv_sep == ';' %} selected="selected"{% endif %} value=";">{{ l('label_semi_colon_char') }}</option>{% if csv_sep != ',' and csv_sep != ';' %}
<option selected="selected" value="{{ csv_sep }}">{{ csv_sep }}</option>{% endif %}</select></label></p>
  {% if issue_count > issues_export_limit %}
  <p class="icon icon-warning">
    {{ sprite_icon('warning', l('setting_issues_export_limit')) }}: {{ issues_export_limit }}
  </p>
  {% endif %}
  <p class="buttons">
    <input type="submit" value="{{ l('button_export') }}" onclick="hideModal(this);" />
    <a href="#" onclick="hideModal(this);; return false;">{{ l('button_cancel') }}</a>
  </p>
</form></div>
{% endif %}

{% endif %}
