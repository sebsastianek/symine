{% extends 'base.html.twig' %}
{% block main_menu %}{% endblock %}
{% block content %}
<h2>{{ l('twofa_generate_backup_codes') }}</h2>

<div class="splitcontentleft">
  <form id="twofa_form" action="{{ path('twofa_backup_codes_create') }}" accept-charset="UTF-8" method="post">{{ csrf_field() }}
    {% include 'twofa/_twofa_code_form.html.twig' %}
    <input type="submit" name="submit_otp" value="{{ l('button_submit') }}" data-disable-with="{{ l('button_submit') }}" />
    {% if resendable %}<a rel="nofollow" data-method="post" href="{{ path('twofa_backup_codes_init') }}">{{ l('twofa_resend_code') }}</a>{% endif %}
  </form>
</div>
{% endblock %}
{% block sidebar %}{% include 'my/_sidebar.html.twig' %}{% endblock %}
