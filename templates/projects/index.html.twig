{% extends 'base.html.twig' %}
{% block content %}
<div class="contextual">
  <form action="{{ path('projects_index') }}" method="get"></form>
  {%- if allowed_to_globally('add_project') %}<a class="icon icon-add" href="{{ path('project_new') }}">{{ sprite_icon('add', l('label_project_new')) }}</a>{% endif -%}
  {%- if current_user().admin and path_exists('admin_projects') %}<a class="icon icon-settings" href="{{ path('admin_projects') }}">{{ sprite_icon('settings', l('label_administration')) }}</a>{% endif %}
</div>

<h2>{{ query.name ?? l('label_project_plural') }}</h2>
{% if query.description %}<p class="subtitle">{{ query.description }}</p>{% endif %}

<form id="query_form" action="{{ path('projects_index') }}" method="get">
{% include 'projects/_query_form.html.twig' %}
</form>

{% if query.valid %}
  {% if entries|length == 0 %}
    <p class="nodata">{{ l('label_no_data') }}</p>
  {% elseif query.display_type == 'board' %}
    <div id="projects-index">
  {{ render_project_hierarchy(entries) }}
</div>
  {% else %}
    {% include 'projects/_list.html.twig' %}
  {% endif %}
{% else %}
  <div id="errorExplanation"><ul>{% for e in query.errors %}<li>{{ e }}</li>{% endfor %}</ul></div>
{% endif %}

{% if current_user().isLogged() %}
<p style="text-align:right;">
<span class="icon icon-user my-project">{{ sprite_icon('user', l('label_my_projects')) }}</span>
<span class="icon icon-bookmarked-project">{{ sprite_icon('bookmarked', l('label_my_bookmarks')) }}</span>
</p>
{% endif %}

<p class="other-formats hide-when-print">{{ l('label_export_to') }}{% if query.display_type == 'list' %} <span><a class="csv" rel="nofollow" onclick="showModal('csv-export-options', '350px'); return false;" href="{{ path('projects_index_format', {_format: 'csv'}) }}{% if app.request.query.all is not empty %}?{{ rails_to_query(app.request.query.all) }}{% endif %}">CSV</a></span>{% endif %} <span><a class="atom" rel="nofollow" href="{{ path('projects_index_format', {_format: 'atom'}|merge(atom_key ? {key: atom_key} : {})) }}">Atom</a></span>
</p>
{% endblock %}

{% block sidebar %}
{% if sidebar_queries|length > 0 %}
<h3>{{ l('label_query_plural') }}</h3>
<ul class="queries">{% for q in sidebar_queries %}<li><a class="query{% if query.id == q.id %} selected{% endif %}" data-disable-with="{{ q.name }}" href="{{ path('projects_index', {query_id: q.id}) }}">{{ q.name }}</a></li>
{% endfor %}</ul>
{% endif %}
{% endblock %}
