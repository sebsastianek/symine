{% if allowed_to('manage_repository', project) and path_exists('repository_new') %}
  <p><a class="icon icon-add" href="{{ path('repository_new', {project_id: project.identifier}) }}">{{ sprite_icon('add', l('label_repository_new')) }}</a></p>
{% endif %}
{% if repositories|length > 0 %}
<table class="list">
  <thead>
    <tr>
      <th>{{ l('field_identifier') }}</th>
      <th>{{ l('field_repository_is_default') }}</th>
      <th>{{ l('label_scm') }}</th>
      <th>{{ l('label_repository') }}</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
  {% for repository in repositories %}
    <tr>
      <td class="name">{{ repository.identifier }}</td>
      <td class="tick">{% if repository.isDefault %}<span class="icon-only icon-checked">{{ sprite_icon('checked') }}</span>{% endif %}</td>
      <td>{{ repository.scmName() }}</td>
      <td>{{ repository.url }}</td>
      <td class="buttons"></td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<p class="nodata">{{ l('label_no_data') }}</p>
{% endif %}
