{#- Port of queries/_query_form.html.erb for ProjectQuery -#}
<input type="hidden" name="set_filter" id="set_filter" value="1" autocomplete="off" />
<input type="hidden" name="type" id="query_type" value="ProjectQuery" disabled="disabled" autocomplete="off" />
<input type="hidden" name="sort" value="{{ query.sort|map(s => s[0] ~ (s[1] == 'desc' ? ':desc' : ''))|join(',') }}" autocomplete="off" />

<div id="query_form_with_buttons" class="hide-when-print">
<div id="query_form_content">
  <fieldset id="filters" class="collapsible {{ query.id ? 'collapsed' : '' }}">
    <legend onclick="toggleFieldset(this);" class="icon icon-{{ query.id ? 'collapsed' : 'expanded' }}">
      {{ sprite_icon(query.id ? 'angle-right' : 'angle-down') }}
      {{ l('label_filter_plural') }}
    </legend>
    <div style="{{ query.id ? 'display: none;' : '' }}">
      <script>
//<![CDATA[
var operatorLabels = {{ operator_labels|json_encode|raw }};
var operatorByType = {{ operators_by_type|json_encode|raw }};
var availableFilters = {{ available_filters|json_encode|raw }};
var labelDayPlural = {{ l('label_day_plural')|json_encode|raw }};

var filtersUrl = "";

$(document).ready(function(){
  initFilters();
  {% for field, f in query.filters %}
  addFilter({{ field|json_encode|raw }}, {{ f.operator|json_encode|raw }}, {{ f.values|json_encode|raw }});
  {% endfor %}
});
//]]>
</script>
<div id="filters-table">
</div>

<div class="add-filter">
<label for="add_filter_select">{{ l('label_filter_add') }}</label>
<select id="add_filter_select"><option value=""></option>
{%- set text_filters = [] -%}{%- set date_filters = [] -%}
{% for field, f in available_filters %}
  {%- if f.type in ['text', 'string'] -%}{%- set text_filters = text_filters|merge([[field, f.name]]) -%}
  {%- elseif f.type in ['date', 'date_past'] -%}{%- set date_filters = date_filters|merge([[field, f.name]]) -%}
  {%- else %}
<option value="{{ field }}">{{ f.name }}</option>
  {%- endif -%}
{% endfor %}
{%- if text_filters|length > 0 %}<optgroup label="{{ l('label_string') }}">{% for f in text_filters %}<option value="{{ f[0] }}">{{ f[1] }}</option>
{% endfor %}</optgroup>{% endif -%}
{%- if date_filters|length > 0 %}<optgroup label="{{ l('label_date') }}">{% for f in date_filters %}<option value="{{ f[0] }}">{{ f[1] }}</option>
{% endfor %}</optgroup>{% endif -%}
</select>
</div>

<input type="hidden" name="f[]" id="f_" value="" autocomplete="off" />
    </div>
  </fieldset>

    <fieldset id="options" class="collapsible collapsed">
      <legend onclick="toggleFieldset(this);" class="icon icon-collapsed">
        {{ sprite_icon('angle-right') }}
        {{ l('label_options') }}
      </legend>
        <div class="hidden">
          <div>
            <div class="field"><label for='display_type'>{{ l('label_display_type') }}</label></div>
            {% for t in ['board', 'list'] %}<input type="radio" name="display_type" id="display_type_{{ t }}" value="{{ t }}"{% if query.display_type == t %} checked="checked"{% endif %} /><label for="display_type_{{ t }}" class="inline">{{ l('label_display_type_' ~ t) }}</label>{% endfor %}
          </div>
          <div id="list-definition" class="{{ query.display_type == 'board' ? 'hidden' : '' }}">
            <div>
              <div class="field">{{ l('field_column_names') }}</div>
<div class="query-columns">
      <label for="available_c">{{ l('description_available_columns') }}</label>
      <select name="available_columns[]" id="available_c" multiple="multiple" size="10" ondblclick="moveOptions(this.form.available_c, this.form.selected_c);">{% for name, caption in available_columns %}{% if name not in query.columns %}<option value="{{ name }}">{{ caption }}</option>
{% endif %}{% endfor %}</select>
</div>
<div class="buttons">
      <button type="button" class="move-right" onclick="moveOptions(this.form.available_c, this.form.selected_c);">{{ sprite_icon('arrow-narrow-right') }}</button>
      <button type="button" class="move-left" onclick="moveOptions(this.form.selected_c, this.form.available_c);">{{ sprite_icon('arrow-narrow-left') }}</button>
</div>
<div class="query-columns">
      <label for="selected_c">{{ l('description_selected_columns') }}</label>
      <select name="c[]" id="selected_c" multiple="multiple" size="10" ondblclick="moveOptions(this.form.selected_c, this.form.available_c);">{% for name in query.columns %}{% if available_columns[name] is defined %}<option value="{{ name }}">{{ available_columns[name] }}</option>
{% endif %}{% endfor %}</select>
</div>
<div class="buttons">
      <button type="button" onclick="moveOptionTop(this.form.selected_c);">&#8648;</button>
      <button type="button" onclick="moveOptionUp(this.form.selected_c);">&#8593;</button>
      <button type="button" onclick="moveOptionDown(this.form.selected_c);">&#8595;</button>
      <button type="button" onclick="moveOptionBottom(this.form.selected_c);">&#8650;</button>
</div>

<script>
//<![CDATA[
$(document).ready(function(){
  $('.query-columns').closest('form').submit(function(){
    $('#selected_c option:not(:disabled)').prop('selected', true);
  });
});
//]]>
</script>
            </div>
            <div>
              <div class="field"><label for='group_by'>{{ l('field_group_by') }}</label></div>
              <div><select name="group_by" id="group_by"><option value=""></option>
{% for name, caption in groupable_columns %}<option value="{{ name }}"{% if query.group_by == name %} selected="selected"{% endif %}>{{ caption }}</option>{% endfor %}</select></div>
            </div>
        </div>
      </div>
    </fieldset>
</div>

<p class="buttons">
  <a href="#" onclick="$(&quot;#query_form&quot;).submit(); return false;" class="icon icon-checked">{{ sprite_icon('checked', l('button_apply')) }}</a>
  <a class="icon icon-reload" href="{{ path('projects_index', {set_filter: 1, sort: ''}) }}">{{ sprite_icon('reload', l('button_clear')) }}</a>
  {% if current_user().isLogged() and path_exists('query_new') %}
      <a href="#" onclick="$('#query_type').prop('disabled',false);$('#query_form').attr('action', '{{ path('query_new') }}').submit(); return false;" class="icon icon-save">{{ sprite_icon('save', l('button_save')) }}</a>
  {% endif %}
</p>
</div>

<script>
//<![CDATA[
$(function ($) {
  $('input[name=display_type]').change(function (e) {
    if ($("#display_type_list").is(':checked')) {
      $('#list-definition').show();
    } else {
      $('#list-definition').hide();
    }
  })
});
//]]>
</script>
