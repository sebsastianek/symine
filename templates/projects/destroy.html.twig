{% extends 'base.html.twig' %}
{% block content %}
<h2>{{ l('label_confirmation') }}</h2>

<form action="{{ path('project_destroy', {id: project_to_destroy.identifier}) }}" method="post">
{{ csrf_field() }}<input type="hidden" name="_method" value="delete" />
<div class="warning">
<p><strong>{{ project_to_destroy.name }}</strong></p>

<p>
{{ l('text_project_destroy_confirmation') }}
{% if descendants|length > 0 %}
  <br />
  {{ l('text_subprojects_destroy_warning', {value: '<strong>' ~ (descendants|map(d => d.name|e)|join(', ')) ~ '</strong>'})|raw }}
{% endif %}
</p>

<p>
  {{ l('text_project_destroy_enter_identifier', {identifier: project_to_destroy.identifier}) }}
</p>

<p>
  <label for="confirm">{{ l('field_identifier') }}</label>
  <input type="text" name="confirm" id="confirm" />
</p>

</div>

<p>
  <input type="submit" name="commit" value="{{ l('button_delete') }}" data-disable-with="{{ l('button_delete') }}" />
  <a href="{{ cancel_url }}">{{ l('button_cancel') }}</a>
</p>
</form>
{% endblock %}
