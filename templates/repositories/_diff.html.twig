{% for table_file in diff.tables %}
<div class="autoscroll">
{% if diff.type == 'sbs' %}
<table class="filecontent diffcontent">
<thead>
<tr>
  <th colspan="4" class="filename">
    {% if table_file.previousFileName %}<span class="previous-filename">{{ table_file.previousFileName }} →</span>{% endif %}
    {{ table_file.fileName }}
  </th>
</tr>
</thead>
<tbody>
{% for item in table_file.eachLine() %}
{% set spacing = item[0] %}{% set line = item[1] %}
{% if spacing %}
<tr class="spacing">
  <th class="line-num" data-txt="..."></th><td></td><th class="line-num" data-txt="..."></th><td></td>
</tr>
{% endif %}
<tr>
  <th class="line-num" data-txt="{{ line.nbLineLeft }}"></th>
  <td class="line-code {{ line.typeDiffLeft }}">
    <div>{{ line.htmlLineLeft()|raw }}</div>
  </td>
  <th class="line-num" data-txt="{{ line.nbLineRight }}"></th>
  <td class="line-code {{ line.typeDiffRight }}">
    <div>{{ line.htmlLineRight()|raw }}</div>
  </td>
</tr>
{% endfor %}
</tbody>
</table>
{% else %}
<table class="filecontent diffcontent">
<thead>
  <tr>
    <th colspan="3" class="filename">
      {% if table_file.previousFileName %}<span class="previous-filename">{{ table_file.previousFileName }} →</span>{% endif %}
      {{ table_file.fileName }}
    </th>
  </tr>
</thead>
<tbody>
{% for item in table_file.eachLine() %}
{% set spacing = item[0] %}{% set line = item[1] %}
{% if spacing %}
<tr class="spacing">
  <th class="line-num">...</th><th class="line-num">...</th><td></td>
</tr>
{% endif %}
<tr>
  <th class="line-num" data-txt="{{ line.nbLineLeft }}"></th>
  <th class="line-num" data-txt="{{ line.nbLineRight }}"></th>
  <td class="line-code {{ line.typeDiff() }}">
    <div>{{ line.htmlLine()|raw }}</div>
  </td>
</tr>
{% endfor %}
</tbody>
</table>
{% endif %}
</div>
{% endfor %}
{% if diff.truncated %}{{ l('text_diff_truncated') }}{% endif %}
