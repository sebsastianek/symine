{% extends 'base.html.twig' %}
{% block header_tags %}{% include 'repositories/_header_tags.html.twig' %}
<link rel="alternate" type="application/atom+xml" title="ATOM" href="{{ repo_url('revisions', repository) }}.atom{% if atom_key|default(null) %}?key={{ atom_key }}{% endif %}" />
{% endblock %}
{% block content %}
<div class="contextual">
<form action="{{ repo_url('revision', repository) }}" accept-charset="UTF-8" method="get">
  {{ l('label_revision') }}: <input type="text" name="rev" id="rev" size="8" />
  <input type="submit" value="{{ l('button_view') }}" />
</form>
</div>

<h2>{{ l('label_revision_plural') }}</h2>

{% include 'repositories/_revisions.html.twig' with {path: '', revisions: changesets} %}

{% include 'common/_pagination.html.twig' %}

<p class="other-formats hide-when-print">{{ l('label_export_to') }}
<span><a class="atom" rel="nofollow" href="{{ repo_url('revisions', repository) }}.atom{% if atom_key|default(null) %}?key={{ atom_key }}{% endif %}">Atom</a></span>
</p>
{% endblock %}
