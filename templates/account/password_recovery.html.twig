{% extends 'base.html.twig' %}
{% import 'my/_macros.html.twig' as m %}
{% block content %}
{% if error %}<div class="flash error" id="flash_error">{{ error }}</div>{% endif %}
<h2>{{ l('label_password_lost') }}</h2>

{{ m.errors(errors) }}

<form action="{{ path('lost_password') }}" accept-charset="UTF-8" method="post">
  {{ csrf_field() }}
  <input type="hidden" name="token" id="token" value="{{ token.value }}" autocomplete="off" />
  <div class="box tabular">
    <p>
      <label for="new_password">{{ l('field_new_password') }} <span class="required">*</span></label>
      <input type="password" name="new_password" id="new_password" size="25" autocomplete="new-password" />
      <em class="info">{{ l('text_caracters_minimum', {count: settings.int('password_min_length')}) }}</em>
      {% set classes = settings.array('password_required_char_classes') %}
      {% if classes is not empty %}
        <em class="info">{{ l('text_characters_must_contain', {character_classes: classes|map(c => l('label_password_char_class_' ~ c))|join(', ')}) }}</em>
      {% endif %}
    </p>

    <p>
      <label for="new_password_confirmation">{{ l('field_password_confirmation') }} <span class="required">*</span></label>
      <input type="password" name="new_password_confirmation" id="new_password_confirmation" size="25" autocomplete="new-password" />
    </p>
  </div>
  <p><input type="submit" name="commit" value="{{ l('button_save') }}" /></p>
</form>
{% endblock %}
