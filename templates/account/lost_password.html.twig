{% extends 'base.html.twig' %}
{% block content %}
{% if error %}<div class="flash error" id="flash_error">{{ sprite_icon('warning') }}{{ error }}</div>{% endif %}
<h2>{{ l('label_password_lost') }}</h2>

<form action="{{ path('lost_password') }}" accept-charset="UTF-8" method="post">
  {{ csrf_field() }}
  <div class="box tabular">
    <p>
      <label for="mail">{{ l('field_mail') }} <span class="required">*</span></label>
      <input type="text" name="mail" id="mail" size="40" />
      <input type="submit" name="commit" value="{{ l('button_submit') }}" />
    </p>
  </div>
</form>
{% endblock %}
