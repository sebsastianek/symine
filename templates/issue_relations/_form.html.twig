{% set unsaved_relations = unsaved_relations ?? [] %}
{% set unsaved_ids = '' %}
{% if unsaved_relations|length > 0 %}
  {% set unsaved_ids = unsaved_relations|map(r => r.issue_to_id)|filter(v => v)|join(', ') %}
  <div id="errorExplanation">
    {{ sprite_icon('warning', null, 18, false, 'notice-icon') }}
    <ul>
      {% for r in unsaved_relations %}{% for e in r.errors %}<li>{{ r.issue_to_id ? '#' ~ r.issue_to_id ~ ': ' : '' }}{{ e }}</li>{% endfor %}{% endfor %}
    </ul>
  </div>
{% endif %}
<p><select onchange="setPredecessorFieldsVisibility();" name="relation[relation_type]" id="relation_relation_type">
{% for t in issue_relation_types() %}<option{% if loop.first %} selected="selected"{% endif %} value="{{ t[0] }}">{{ t[1] }}</option>
{% endfor %}</select>
{{ l('label_issue') }} #<input value="{{ unsaved_ids }}" size="10" type="text" name="relation[issue_to_id]" id="relation_issue_to_id" />
<span id="predecessor_fields" style="display:none;">
{{ l('field_delay') }}: <input size="3" type="text" name="relation[delay]" id="relation_delay" /> {{ l('label_day_plural') }}
</span>
<input type="submit" name="commit" value="{{ l('button_add') }}" data-disable-with="{{ l('button_add') }}" />
<a href="#" onclick="$(&quot;#new-relation-form&quot;).hide(); return false;">{{ l('button_cancel') }}</a>
<em class="info">{{ l('text_comma_separated') }}</em>
</p>

<script>
multipleAutocompleteField('relation_issue_to_id', '{{ path('issues_auto_complete', {issue_id: issue.id, project_id: project.identifier, scope: (setting('cross_project_issue_relations') in ['1', 1, true] ? 'all' : null)})|e('js') }}');
setPredecessorFieldsVisibility();
</script>
