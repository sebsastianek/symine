<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Format de la Wiki</title>
<link rel="stylesheet" href="{{ asset_base }}/assets/wiki_syntax.css" media="screen" />
</head>
<body>

<h1>Guia rapida de la Sintaxis de la Wiki</h1>

<table style="width:100%">
<tr><th colspan="3">Estil de font <span class="more_info">(<a href="{{ path('help_wiki_syntax', {type: 'detailed'}) }}#5" target="_blank">more</a>)</span></th></tr>
<tr><th><img alt="Negreta" src="{{ asset_base }}/assets/jstoolbar/bold.svg" /></th><td style="width:50%;">*Negreta*</td><td style="width:50%;"><strong>Negreta</strong></td></tr>
<tr><th><img alt="Cursiva" src="{{ asset_base }}/assets/jstoolbar/italic.svg" /></th><td>_Cursiva_</td><td><em>Cursiva</em></td></tr>
<tr><th><img alt="Subratllat" src="{{ asset_base }}/assets/jstoolbar/underline.svg" /></th><td>+Subratllat+</td><td><ins>Subratllat</ins></td></tr>
<tr><th><img alt="Eliminat" src="{{ asset_base }}/assets/jstoolbar/strikethrough.svg" /></th><td>-Eliminat-</td><td><del>Eliminat</del></td></tr>
<tr><th></th><td>??Cita??</td><td><cite>Cita</cite></td></tr>
<tr><th><img alt="Codi en línia" src="{{ asset_base }}/assets/jstoolbar/letter-c.svg" /></th><td>@Codi en línia@</td><td><code>Codi en línia</code></td></tr>
<tr><th><span class="syntax-pre"/></th><td>&lt;pre&gt;<br />&nbsp;linies<br />&nbsp;de codi<br />&lt;/pre&gt;</td><td>
<pre>
 linies
 de codi
</pre>
</td></tr>

<tr><th colspan="3">Highlighted code <span class="more_info">(<a href="{{ path('help_wiki_syntax', {type: 'detailed'}) }}#13" target="_blank">more</a> | <a href="{{ code_highlighting_url }}" target="_blank">supported languages</a>)</span></th></tr>
<tr><th><img alt="Highlighted code" src="{{ asset_base }}/assets/jstoolbar/code.svg" /></th><td>&lt;pre&gt;&lt;code class="ruby"&gt;<br />3.times do<br />&nbsp;&nbsp;puts 'Hello'<br />end<br />&lt;/code&gt;&lt;/pre&gt;</td><td>
<pre><code class="ruby syntaxhl"><span class="mi">3</span><span class="p">.</span><span class="nf">times</span> <span class="k">do</span>
  <span class="nb">puts</span> <span class="s1">'Hello'</span>
<span class="k">end</span>
</code></pre>
</td></tr>

<tr><th colspan="3">Mermaid diagrams <span class="more_info">(<a href="{{ path('help_wiki_syntax', {type: 'detailed'}) }}#15" target="_blank">more</a>)</span></th></tr>
<tr><th></th><td>&lt;pre&gt;&lt;code class="mermaid"&gt;<br />flowchart TD<br />&nbsp;&nbsp;A[Start] --&gt; B[End]<br />&lt;/code&gt;&lt;/pre&gt;</td><td><img width="168" alt="Flowchart from Start to End" src="{{ asset_base }}/assets/help/mermaid_flowchart_simple.png" /></td></tr>

<tr><th colspan="3">Llistes</th></tr>
<tr><th><img alt="Llista desordenada" src="{{ asset_base }}/assets/jstoolbar/list.svg" /></th><td>* Article 1<br />** Sub<br />* Article 2</td><td><ul><li>Article 1<ul><li>Sub</li></ul></li><li>Article 2</li></ul></td></tr>
<tr><th><img alt="Llista ordenada" src="{{ asset_base }}/assets/jstoolbar/list-numbers.svg" /></th><td># Article 1<br />## Sub<br /># Article 2</td><td><ol><li>Article 1<ol><li>Sub</li></ol></li><li>Article 2</li></ol></td></tr>

<tr><th colspan="3">Capçaleres <span class="more_info">(<a href="{{ path('help_wiki_syntax', {type: 'detailed'}) }}#8" target="_blank">more</a>)</span></th></tr>
<tr><th><img alt="Encapçament 1" src="{{ asset_base }}/assets/jstoolbar/h1.svg" /></th><td>h1. Títol 1</td><td><h1>Títol 1</h1></td></tr>
<tr><th><img alt="Encapçament 2" src="{{ asset_base }}/assets/jstoolbar/h2.svg" /></th><td>h2. Títol 2</td><td><h2>Títol 2</h2></td></tr>
<tr><th><img alt="Encapçament 3" src="{{ asset_base }}/assets/jstoolbar/h3.svg" /></th><td>h3. Títol 3</td><td><h3>Títol 3</h3></td></tr>

<tr><th colspan="3">Links <span class="more_info">(<a href="{{ path('help_wiki_syntax', {type: 'detailed'}) }}#4" target="_blank">more</a>)</span></th></tr>
<tr><th></th><td>http://example.com</td><td><a href="#">http://example.com</a></td></tr>
<tr><th></th><td>"Foo":http://example.com</td><td><a href="#">Foo</a></td></tr>

<tr><th colspan="3">Links del Redmine <span class="more_info">(<a href="{{ path('help_wiki_syntax', {type: 'detailed'}) }}#3" target="_blank">more</a>)</span></th></tr>
<tr><th><img alt="Link a la pagina Wiki" src="{{ asset_base }}/assets/jstoolbar/wiki_link.svg" /></th><td>[[Pagina Wiki]]</td><td><a href="#">Pagina Wiki</a></td></tr>
<tr><th></th><td>Assumpte #12</td><td>Assumpte <a href="#">#12</a></td></tr>
<tr><th></th><td>##12</td><td><a href="#">Bug #12</a>: The issue subject</td></tr>
<tr><th></th><td>Revisió r43</td><td>Revisió <a href="#">r43</a></td></tr>
<tr><th></th><td>commit:f30e13e43</td><td><a href="#">f30e13e4</a></td></tr>
<tr><th></th><td>source:some/file</td><td><a href="#">source:some/file</a></td></tr>

<tr><th colspan="3">Imatges <span class="more_info">(<a href="{{ path('help_wiki_syntax', {type: 'detailed'}) }}#7" target="_blank">more</a>)</span></th></tr>
<tr><th><img alt="Imatge" src="{{ asset_base }}/assets/jstoolbar/image.svg" /></th><td>!<em>imatge_url</em>!</td><td></td></tr>
<tr><th></th><td>!<em>imatge_adjunta</em>!</td><td></td></tr>

<tr><th colspan="3">Taules</th></tr>
<tr>
  <th></th>
  <td>|_. A |_. B |_. C |<br />| A | B | C |<br />|/2. row span | B | C |<br />|\2. col span |</td>
  <td>
    <table class="sample">
      <tbody>
        <th>A</th><th>B</th><th>C</th>
        <tr><td>A</td><td>B</td><td>C</td></tr>
        <tr><td rowspan="2">row span</td><td>B</td><td>C</td></tr>
        <tr><td colspan="2">col span</td></tr>
      </tbody>
    </table>
  </td>
</tr>

</table>

<p><a href="{{ path('help_wiki_syntax', {type: 'detailed'}) }}" onclick="window.open('{{ path('help_wiki_syntax', {type: 'detailed'}) }}', '', ''); return false;">Més informació</a></p>

</body>
</html>
