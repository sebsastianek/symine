<!DOCTYPE html>
<html>
<head><meta charset="utf-8" /><title>{{ l('doorkeeper.authorizations.form_post.title') }}</title></head>
<body>
<header class="page-header">
  <h1>{{ l('doorkeeper.authorizations.form_post.title') }}</h1>
</header>

<form name="redirect_form" action="{{ redirect_uri }}" accept-charset="UTF-8" method="post">
  {% for key, value in body %}
    <input type="hidden" name="{{ key }}" id="{{ key }}" value="{{ value }}" autocomplete="off" />
  {% endfor %}
</form>

<script>
  window.onload = function () {
    document.forms['redirect_form'].submit();
  };
</script>
</body>
</html>
