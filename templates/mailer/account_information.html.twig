{% extends 'mailer/layout.html.twig' %}
{% block content %}
{% if auth_source %}
<p>{{ l('mail_body_account_information_external', {value: auth_source.name}) }}</p>
{% else %}
<p>{{ l('mail_body_account_information') }}:</p>
<ul>
    <li>{{ l('field_login') }}: {{ user.login }}</li>
    {% if password %}
    <li>{{ l('field_password') }}: {{ password }}</li>
    {% endif %}
</ul>
{% endif %}

<p>{{ l('label_login') }}: <a href="{{ login_url }}">{{ login_url }}</a></p>
{% endblock %}
