<!DOCTYPE html>
<html>
<head>
<style>
body { font-family: Verdana, sans-serif; font-size: 0.8em; color:#484848; }
h1, h2, h3 { font-family: "Trebuchet MS", Verdana, sans-serif; margin: 0px; }
a, a:link, a:visited { color: #2A5685;}
a:hover, a:active { color: #c61a1a; }
hr { width: 100%; height: 1px; background: #ccc; border: 0; }
.footer { font-size: 0.8em; font-style: italic; }
</style>
</head>
<body>
{% if emails_header %}<div class="header">{{ textilizable(emails_header) }}</div>{% endif %}
{% block body %}{% endblock %}
{% if emails_footer %}<hr />
<span class="footer">{{ textilizable(emails_footer) }}</span>{% endif %}
</body>
</html>
