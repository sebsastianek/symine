<h1>
  <a href="{{ issue_url }}">{{ issue.tracker.name }} #{{ issue.id }}: {{ issue.subject }}</a>
  {% if issue.status.isClosed %}<span class="badge badge-status-closed">{{ l('label_closed_issues') }}</span>{% else %}<span class="badge badge-status-open">{{ l('label_open_issues') }}</span>{% endif %}
</h1>

<ul class="details">
{% for item in mail.issueAttributes(issue, user) %}<li><strong>{{ item.label }}: </strong>{{ item.value }}</li>
{% endfor %}</ul>

{{ mail.textilizable(issue.description, issue.project, issue)|raw }}

{% set attachments = mail.attachmentsOf('Issue', issue.id) %}
{% if attachments is not empty %}
  <fieldset class="attachments"><legend>{{ l('label_attachment_plural') }}</legend>
  {% for attachment in attachments %}
    {{ mail.linkToAttachment(attachment)|raw }}
    ({{ mail.humanSize(attachment.filesize) }})<br />
  {% endfor %}
  </fieldset>
{% endif %}
