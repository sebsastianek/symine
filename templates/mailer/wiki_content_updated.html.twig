{% extends 'mailer/layout.html.twig' %}
{% block content %}
<p>{{ l('mail_body_wiki_content_updated', {id: '<a href="' ~ (wiki_content_url|e) ~ '">' ~ (page.prettyTitle|e) ~ '</a>', author: (wiki_content.author ? wiki_content.author.name : '')|e})|raw }}<br />
<em>{{ wiki_content.comments }}</em></p>

<p>{{ l('label_view_diff') }}:<br />
<a href="{{ wiki_diff_url }}">{{ wiki_diff_url }}</a></p>
{% endblock %}
