<ul>{% for item in items %}<li{% if item.children is defined and item.children %} class="{{ item.class ?? '' }}"{% endif %}><a class="{{ item.name|replace({'_': '-'}) }}{% if item.class is defined and item.class %} {{ item.class }}{% endif %}{% if item.selected ?? false %} selected{% endif %}" href="{{ item.url }}"{% for k, v in item.html ?? {} %} {{ k }}="{{ v }}"{% endfor %}>{% if item.icon is defined and item.icon %}{{ sprite_icon(item.icon, item.caption) }}{% else %}{{ item.caption }}{% endif %}</a>{% if item.children is defined and item.children %}<ul class="menu-children">{% for c in item.children %}<li><a class="{{ c.name|replace({'_': '-'}) }}" href="{{ c.url }}">{{ c.caption }}</a></li>{% endfor %}</ul>{% endif %}</li>{% endfor %}</ul>
