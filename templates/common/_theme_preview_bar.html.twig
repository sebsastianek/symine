{#- Shown to an administrator who is trying a theme out -#}
{%- set _previewed = theme_context().previewed() -%}
<div id="theme-preview-bar" style="display:flex;gap:12px;align-items:center;justify-content:center;flex-wrap:wrap;padding:6px 12px;background:#1f2933;color:#fff;font:13px/1.4 system-ui,sans-serif;">
  <span>{{ l('text_theme_previewing', {name: _previewed.name}) }}</span>
  <form action="{{ path('admin_themes_activate', {id: _previewed.id}) }}" method="post" style="display:inline;margin:0">{{ csrf_field() }}<button type="submit">{{ l('button_theme_use') }}</button></form>
  <form action="{{ path('admin_themes_preview_stop') }}" method="post" style="display:inline;margin:0">{{ csrf_field() }}<button type="submit">{{ l('button_theme_stop_preview') }}</button></form>
</div>
