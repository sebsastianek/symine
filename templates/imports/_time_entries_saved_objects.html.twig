<table id="saved-items" class="list">
  <thead>
  <tr>
    <th>{{ l('field_project') }}</th>
    <th>{{ l('field_user') }}</th>
    <th>{{ l('field_activity') }}</th>
    <th>{{ l('field_issue') }}</th>
    <th>{{ l('field_spent_on') }}</th>
    <th>{{ l('field_hours') }}</th>
    <th>{{ l('field_comments') }}</th>
  </tr>
  </thead>
  <tbody>
  {% for time_entry in saved_objects %}
  <tr>
    <td>{% if path_exists('project_time_entries') %}<a href="{{ path('project_time_entries', {project_id: time_entry.project.identifier}) }}">{{ time_entry.project.name }}</a>{% else %}{{ link_to_project(time_entry.project) }}{% endif %}</td>
    <td>{{ link_to_user(time_entry.user) }}</td>
    <td>{{ time_entry.activity.name }}</td>
    <td>{% if time_entry.issue %}{{ link_to_issue(time_entry.issue) }}{% endif %}</td>
    <td>{{ format_date(time_entry.spentOn) }}</td>
    <td>{{ format_hours(time_entry.hours) }}</td>
    <td>{{ time_entry.comments }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
