{% extends 'base.html.twig' %}
{% block header_tags %}<link rel="stylesheet" href="/assets/scm.css" media="all" />{% endblock %}
{% block content %}
<div class="contextual">
  {{ attachment_link(attachment, {text: l('button_download') ~ ' (' ~ number_to_human_size(attachment.filesize) ~ ')', download: true, class: 'icon icon-download', icon: 'download'}) }}
</div>

<h2>
  {% if container_link %}{{ container_link|raw }} &#187; {% endif %}{{ attachment.filename }}
</h2>

<div class="attachments">
<p>
  {% if attachment.description is not empty %}{{ attachment.description }}<br>{% endif %}
  <span class="author">
    {{ link_to_user(attachment.author) }}, {{ format_time(attachment.createdOn) }}{% if attachment.contentType %}, <span class="content-type">{{ attachment.contentType }}</span>{% endif %}
  </span>
</p>
</div>
<div class="filecontent-container">
{% if kind == 'image' %}
  <img alt="{{ attachment.filename }}" class="filecontent image" src="{{ path('attachment_download', {id: attachment.id, filename: attachment.filename}) }}" />
{% elseif kind == 'file' %}
  &nbsp;
  <div class="autoscroll">
  <table class="filecontent syntaxhl">
  <tbody>
  {% for line in syntax_highlight_lines(attachment.filename, content ?? '') %}
    <tr id="L{{ loop.index }}">
      <th class="line-num"><a href="#L{{ loop.index }}" data-txt="{{ loop.index }}"></a></th>
      <td class="line-code">
        {% if line == "\n" or line == "\r\n" %}<br>{% else %}<div>{{ line|raw }}</div>{% endif %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
  </table>
  </div>
{% elseif kind == 'markup' %}
  <div class="wiki">{{ markup|raw }}</div>
{% elseif kind == 'pdf' %}
  <iframe class="filecontent pdf" src="{{ path('attachment_download', {id: attachment.id, filename: attachment.filename, disposition: 'inline'}) }}" width="100%" height="600" sandbox="allow-scripts allow-same-origin"></iframe>
{% else %}
  {% set download_link = attachment_link(attachment, {text: l('label_no_preview_download'), icon: 'download', download: true, class: 'icon icon-download'}) %}
  {% if kind == 'video' %}<video class="filecontent" src="{{ url('attachment_download', {id: attachment.id, filename: attachment.filename}) }}" controls="controls">{% elseif kind == 'audio' %}<audio class="filecontent" src="{{ url('attachment_download', {id: attachment.id, filename: attachment.filename}) }}" controls="controls">{% endif %}
  <p class="nodata">{{ l('label_no_preview_alternative_html', {link: download_link})|raw }}</p>
  {% if kind == 'video' %}</video>{% elseif kind == 'audio' %}</audio>{% endif %}
{% endif %}
</div>

{% if siblings|length > 1 %}
<span class="pagination filepreview">
  <ul class="pages">
    {% if index > 0 %}{% set prev = siblings[index - 1] %}<li class="previous page"><a accesskey="p" href="{{ path('attachment_show', {id: prev.id, filename: prev.filename}) }}">&#171; {{ l('label_previous') }}</a></li>{% else %}<li class="previous"><span>&#171; {{ l('label_previous') }}</span></li>{% endif %}
    {% for s in siblings %}{% if loop.index0 == index %}<li class="current"><span>{{ loop.index }}</span></li>{% else %}<li class="page"><a href="{{ path('attachment_show', {id: s.id, filename: s.filename}) }}">{{ loop.index }}</a></li>{% endif %}{% endfor %}
    {% if index < siblings|length - 1 %}{% set next = siblings[index + 1] %}<li class="next page"><a accesskey="n" href="{{ path('attachment_show', {id: next.id, filename: next.filename}) }}">{{ l('label_next') }} &#187;</a></li>{% else %}<li class="next"><span>{{ l('label_next') }} &#187;</span></li>{% endif %}
  </ul>
</span>
{% endif %}
{% endblock %}
