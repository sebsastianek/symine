<div class="objects-selection"><div id="principals">{% for principal in principals %}<label><input type="checkbox" name="membership[user_ids][]" value="{{ principal.id }}" />{% if principal.isGroup() %}<span class="name icon icon-group">{{ sprite_icon('group') }}</span>{% else %}{{ avatar(principal, 16) }}{% endif %}{{ members_manager is defined ? members_manager.principalName(principal) : principal.getName() }}</label>{% endfor %}</div></div>
{% set pages = (principal_count / 100)|round(0, 'ceil') %}
{% if pages > 1 %}
<span class="pagination"><ul class="pages">{% for p in 1..pages %}{% if p == (page ?? 1) %}<li class="current"><span>{{ p }}</span></li>{% else %}<li><a data-remote="true" href="{{ path('member_autocomplete_js', {project_id: project.identifier, page: p, q: q ?? ''}) }}">{{ p }}</a></li>{% endif %}{% endfor %}</ul><span><span class="items">({{ ((page ?? 1) - 1) * 100 + 1 }}-{{ min((page ?? 1) * 100, principal_count) }}/{{ principal_count }})</span></span></span>
{% endif %}
