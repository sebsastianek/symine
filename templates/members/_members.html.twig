{#- members/_members.html.erb (project settings members tab). Needs project, members, members_manager -#}
{% if current_user().admin and path_exists('users_index') %}
  <div class="contextual"><a class="icon icon-settings" href="{{ path('users_index') }}">{{ sprite_icon('settings', l('label_administration')) }}</a></div>
{% endif %}

{% set can_manage = allowed_to('manage_members', project) %}
{% if can_manage %}
<p><a class="icon icon-add" data-remote="true" href="{{ path('member_new', {project_id: project.identifier}) }}">{{ sprite_icon('add', l('label_member_new')) }}</a></p>
{% endif %}

{% if members|length > 0 %}
<table class="list members">
  <thead>
    <tr>
      <th>{{ l('label_user') }} / {{ l('label_group') }}</th>
      <th>{{ l('label_role_plural') }}</th>
      {% if can_manage %}<th></th>{% endif %}
    </tr>
  </thead>
  <tbody>
  {% for member in members %}
  <tr id="member-{{ member.id }}" class="member">
  <td class="name">
    <span class="icon">
      {% if member.principal.isGroup() %}{% if path_exists('group_show') %}<a class="group" href="{{ path('group_show', {id: member.principal.id}) }}">{{ sprite_icon('group') }}{{ member.principal.getName() }}</a>{% else %}{{ member.principal.getName() }}{% endif %}{% else %}{{ link_to_user(member.principal) }}{% endif %}
    </span>
  </td>
  <td class="roles">
    <span id="member-{{ member.id }}-roles">{{ member.getRoles()|map(r => r.name)|join(', ') }}</span>
    <div id="member-{{ member.id }}-form"></div>
  </td>
  {% if can_manage %}
  <td class="buttons">
      <a class="icon icon-edit" data-remote="true" href="{{ path('member_edit', {id: member.id}) }}">{{ sprite_icon('edit', l('button_edit')) }}</a>
      {% if members_manager.isDeletable(member) %}
      <a class="icon icon-link-break" data-remote="true" rel="nofollow" data-method="delete"{% if not current_user().admin and members_manager.includes(member, current_user()) %} data-confirm="{{ l('text_own_membership_delete_confirmation') }}"{% endif %} href="{{ path('member_destroy', {id: member.id}) }}">{{ sprite_icon('link-break', l('button_remove')) }}</a>
      {% endif %}
  </td>
  {% endif %}
  </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<p class="nodata">{{ l('label_no_data') }}</p>
{% endif %}
