{% extends 'base.html.twig' %}
{% set p = {project_id: project.identifier, id: page.title} %}
{% block content %}
{% include 'wiki/_breadcrumb.html.twig' %}

<h2>{{ original_title }}</h2>

{% if errors|length > 0 %}
<div id="errorExplanation"><ul>{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul></div>
{% endif %}

<form action="{{ path('wiki_rename', p) }}" accept-charset="UTF-8" method="post">{{ csrf_field() }}
<div class="box tabular">
<p><label for="wiki_page_title">{{ l('field_title') }}<span class="required"> *</span></label><input size="100" required="required" type="text" value="{{ page.title }}" name="wiki_page[title]" id="wiki_page_title" /></p>
{% if can_manage_wiki %}
<p><label for="wiki_page_is_start_page">{{ l('field_start_page') }}</label><input name="wiki_page[is_start_page]" type="hidden" value="0" autocomplete="off" /><input type="checkbox" value="1" name="wiki_page[is_start_page]" id="wiki_page_is_start_page"{% if is_start_page %} checked="checked" disabled="disabled"{% endif %} /></p>
{% endif %}
<p><label for="wiki_page_redirect_existing_links">{{ l('field_redirect_existing_links') }}</label><input name="wiki_page[redirect_existing_links]" type="hidden" value="0" autocomplete="off" /><input type="checkbox" value="1" name="wiki_page[redirect_existing_links]" id="wiki_page_redirect_existing_links"{% if redirect_existing_links %} checked="checked"{% endif %} /></p>
{% if can_move %}
<p><label for="wiki_page_wiki_id">{{ l('label_project') }}</label><select name="wiki_page[wiki_id]" id="wiki_page_wiki_id">{{ wiki_options|raw }}</select></p>
{% endif %}
<p><label for="wiki_page_parent_id">{{ l('field_parent_title') }}</label><select name="wiki_page[parent_id]" id="wiki_page_parent_id"><option value=""></option>{{ parent_options|raw }}</select></p>
</div>
<input type="submit" value="{{ l('button_rename') }}" data-disable-with="{{ l('button_rename') }}" />
</form>

<script>
$('#wiki_page_wiki_id').change(function() {
  $.ajax({
    url: '{{ path('wiki_rename', p) }}',
    type: 'get',
    dataType: 'script',
    data: { 'wiki_page[wiki_id]': $('#wiki_page_wiki_id').val() }
  });
});
</script>
{% endblock %}
