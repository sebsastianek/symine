  {% if errors|length > 0 %}<div id="errorExplanation"><ul>{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul></div>{% endif %}
  <div class="box tabular">
    <p>
      <label for="page_title">{{ l('field_title') }}<span class="required"> *</span></label>
      <input name="title" size="60" required="required" type="text" id="page_title" value="{{ title }}" />
      <em class="info">{{ l('text_unallowed_characters') }}: , . / ? ; : |</em>
    </p>
    {% if modal ?? false %}
    <p>
    {% if parent %}
      <label class="inline">
        <input type="checkbox" name="parent" id="parent" value="{{ parent }}" checked="checked" />
        {{ l('field_parent_title') }}: {{ parent }}
      </label>
    {% endif %}
    </p>
    {% elseif parent %}
    <input type="hidden" name="parent" value="{{ parent }}" />
    {% endif %}
  </div>
