{#- Port of documents/_form.html.erb. Params: document, categories, custom_field_values, errors -#}
{% include 'news/_errors.html.twig' %}
<div class="box tabular">
  <p><label for="document_category_id">{{ l('field_category') }}</label><select name="document[category_id]" id="document_category_id">
  {%- for c in categories %}<option{% if document.category is defined and document.category.id == c.id %} selected="selected"{% endif %} value="{{ c.id }}">{{ c.name }}</option>
  {% endfor %}</select></p>
  <p><label for="document_title">{{ l('field_title') }}<span class="required"> *</span></label><input size="60" type="text" value="{{ document.title }}" name="document[title]" id="document_title" /></p>
  <p><label for="document_description">{{ l('field_description') }}</label>{% include ['issues/_wiki_textarea.html.twig', 'content/_textarea.html.twig'] with {name: 'document[description]', id: 'document_description', value: document.description, rows: 15, cols: 60} %}</p>

  {% for cv in custom_field_values %}
    <p>{{ issue_cf_tag('document', cv.field, cv.value, document.project ?? null) }}</p>
  {% endfor %}

  {% if document.id is null %}
    <p><label>{{ l('label_attachment_plural') }}</label>{% include 'content/_attachments_form.html.twig' %}</p>
  {% endif %}
</div>
