{% extends 'base.html.twig' %}
{% block main_menu %}{% endblock %}
{% block content %}
<h2>{{ l('twofa_label_setup') }}</h2>

<div class="splitcontentleft">
  <form id="twofa_form" action="{{ path('twofa_activate', {scheme: scheme_name}) }}" accept-charset="UTF-8" method="post">{{ csrf_field() }}

    <div class="box">
      <p>{{ l('twofa__' ~ scheme_name ~ '__text_pairing_info_html')|raw }}</p>
      <div class="tabular">
        {% include 'twofa/' ~ scheme_name ~ '/_new.html.twig' %}
        <p>
          <label for="twofa_code">{{ l('twofa_label_code') }}</label>
          <input type="text" name="twofa_code" id="twofa_code" autocomplete="one-time-code" autofocus="autofocus" />
        </p>
      </div>
    </div>

    <input type="submit" name="submit_otp" value="{{ l('button_activate') }}" data-disable-with="{{ l('button_activate') }}" />
    {% if resendable %}<a rel="nofollow" data-method="post" href="{{ path('twofa_activate_init', {scheme: scheme_name}) }}">{{ l('twofa_resend_code') }}</a>{% endif %}
  </form>
</div>
{% endblock %}
{% block sidebar %}{% if show_sidebar %}{% include 'my/_sidebar.html.twig' %}{% endif %}{% endblock %}
