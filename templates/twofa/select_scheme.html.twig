{% extends 'base.html.twig' %}
{% block main_menu %}{% endblock %}
{% block content %}
<h2>{{ l('twofa_label_setup') }}</h2>

<form action="{{ path('twofa_activate_init_default') }}" accept-charset="UTF-8" method="post">{{ csrf_field() }}
  <div class="box">
  <p>{{ l('twofa_notice_select') }}</p>
  <p>
  {% for s in schemes %}
    <label style="display:block;"><input type="radio" name="scheme" id="scheme_{{ s }}" value="{{ s }}"{% if loop.first %} checked="checked"{% endif %} /> {{ l('twofa__' ~ s ~ '__name') }}</label>
  {% endfor %}
  </p>
  </div>
  <p><input type="submit" name="commit" value="{{ l('label_next') }} &#187;" data-disable-with="{{ l('label_next') }} &#187;" /></p>
</form>
{% endblock %}
{% block sidebar %}{% if show_sidebar %}{% include 'my/_sidebar.html.twig' %}{% endif %}{% endblock %}
