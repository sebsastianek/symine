# Authenticated users may read the directory (needed for sources whose account is "uid=$login,...")
dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword,shadowLastChange by self write by dn="cn=admin,dc=symine,dc=test" write by anonymous auth by * none
olcAccess: {1}to * by self read by dn="cn=admin,dc=symine,dc=test" write by users read by * none
